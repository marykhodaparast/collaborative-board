<div class="dashboard">
  <header class="dashboard-header">
    <div class="brand">
      <div class="brand-icon">✦</div>
      <span>Canvasly</span>
    </div>

    <%= link_to "← All boards", root_path, class: "back-link" %>
  </header>

  <main class="dashboard-main">
    <section class="welcome-section">
      <p class="eyebrow">YOUR COLLABORATIVE SPACE</p>
      <h1><%= @board.title %></h1>
      <p class="subtitle">
        Your ideas deserve a space to grow.
      </p>
    </section>

    <section class="boards-section">
      <div class="section-heading">
        <h2>Pages</h2>
        <span class="board-count">
          <%= pluralize(@board.pages.count, "page") %>
        </span>
      </div>

      <div class="boards-grid">
        <% @board.pages.each do |page| %>
          <div class="board-card">
            <div class="board-preview">
              <span class="preview-decoration">✳</span>
            </div>

            <div class="board-card-info">
              <h3><%= page.name %></h3>
              <p><%= pluralize(page.drawings.count, "drawing") %></p>
            </div>
          </div>
        <% end %>
      </div>
    </section>
  </main>
</div>